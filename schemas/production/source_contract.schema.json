{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Novel Episode Source Contract",
  "type": "object",
  "required": [
    "schema_version",
    "episode_id",
    "mode",
    "status",
    "adaptation_goal",
    "evaluation_dimensions",
    "candidates",
    "selected_source_id",
    "replacement_rule"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "episode_id": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "BEST_FIT_REVISABLE"
      ]
    },
    "status": {
      "enum": [
        "OPEN",
        "PROVISIONAL",
        "LOCKED",
        "REOPENED"
      ]
    },
    "adaptation_goal": {
      "type": "string",
      "minLength": 20
    },
    "evaluation_dimensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "label",
          "current_role",
          "strengths",
          "risks_or_questions",
          "decision_status"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "current_role": {
            "type": "string"
          },
          "strengths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risks_or_questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decision_status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "selected_source_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "selection_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "replacement_rule": {
      "type": "string",
      "minLength": 20
    }
  },
  "additionalProperties": true
}
